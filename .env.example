# Kasie — copy to .env and fill in values.
# Validated by Zod in src/lib/env/index.ts. Full reference: wiki/7-environment-variables.md

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Neon Postgres (pgvector enabled) or self-hosted Postgres 16+
DATABASE_URL=postgresql://user:pass@host/kasie?sslmode=require

# -----------------------------------------------------------------------------
# Deployment (defaults work for local dev)
# -----------------------------------------------------------------------------

DEPLOY_TARGET=vercel
QUEUE_PROVIDER=postgres
# LOG_LEVEL=debug                    # debug | info | warn | error (default: debug in dev, info in prod)
# QUEUE_URL=                         # SQS queue URL — ECS profile only

# -----------------------------------------------------------------------------
# Proactive heartbeat (scheduled tasks + initiative loop)
# -----------------------------------------------------------------------------

# The worker runs the heartbeat internally every PROACTIVE_TICK_MS — no external
# scheduler needed for local dev, Docker, or ECS. Deployments without a worker
# (e.g. Vercel) trigger the same tick via POST /api/cron/heartbeat from any
# scheduler: Vercel Cron (deploy/vercel/vercel.json), a crontab line, a
# Kubernetes CronJob, or curl. Concurrent triggers are safe.
# PROACTIVE_TICK_MS=60000
# WEB_ONLY=1                         # npm run dev without the worker; drives the heartbeat over HTTP

# -----------------------------------------------------------------------------
# Auth — first install uses Slack during /onboarding
# -----------------------------------------------------------------------------

# Required in production (openssl rand -base64 32)
AUTH_SECRET=

# Sign in with Slack + bot install — required for onboarding (wiki/2-slack-app-setup.md)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional invite-only OAuth return sign-in (not used for first install)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Local Slack dev (scripts/dev.mjs — not validated by src/lib/env)
# -----------------------------------------------------------------------------

# When both are set, npm run dev starts a static ngrok tunnel and sets APP_URL.
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# Domain:    https://dashboard.ngrok.com/domains (e.g. kasie-dev.ngrok-free.app)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# DEV_PORT=3002                     # Use when :3000 is taken (e.g. by Cursor)
# APP_URL=                           # Optional override; auto-set when ngrok is active

# -----------------------------------------------------------------------------
# Additional channels (optional — enable tiles on /onboarding when both are set)
# Teams: wiki/3-teams-app-setup.md | Google Chat: wiki/4-google-chat-app-setup.md | Discord: wiki/5-discord-app-setup.md
# -----------------------------------------------------------------------------

# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# GOOGLE_CHAT_CLIENT_ID=
# GOOGLE_CHAT_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------

# Pipedream Connect MCP (optional — live external tools)
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
PIPEDREAM_WEBHOOK_SECRET=

# AES-256-GCM credential vault (openssl rand -hex 32)
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AI providers (at least one for live agent responses; omit for [stub] output)
# -----------------------------------------------------------------------------

# AI gateway (both required for live agent responses; omit for [stub] output)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Model tier defaults (optional — override per-tier model ID and max output tokens)
# When unset, Kasie discovers models from AI Gateway and picks tier defaults automatically.
# MODEL_TIER_ULTRA=openai/gpt-5.4-pro
# MODEL_TIER_ULTRA_MAX_OUTPUT_TOKENS=8192
# MODEL_TIER_SMART=openai/gpt-5.4
# MODEL_TIER_SMART_MAX_OUTPUT_TOKENS=4096
# MODEL_TIER_BALANCED=openai/gpt-4.1-mini
# MODEL_TIER_BALANCED_MAX_OUTPUT_TOKENS=2048

# -----------------------------------------------------------------------------
# Production
# -----------------------------------------------------------------------------

# Bearer token for POST /api/cron/heartbeat (required when NODE_ENV=production)
CRON_SECRET=
